{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hammerhead",
  "version": "0.1.0",
  "identifier": "io.github.martintondel02.hammerhead",
  "mainBinaryName": "hammerhead",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Network",
    "shortDescription": "Native desktop client for Sharkord",
    "longDescription": "Hammerhead is a native desktop client for Sharkord, the self-hosted chat platform with voice, video, and screen sharing."
  },
  "plugins": {}
}