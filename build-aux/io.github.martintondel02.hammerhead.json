{
  "$schema": "https://raw.githubusercontent.com/flatpak/flatpak-builder/main/data/flatpak-manifest.schema.json",
  "id": "io.github.martintondel02.hammerhead",
  "command": "hammerhead",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--socket=pulseaudio",
    "--filesystem=xdg-run/pipewire-0",
    "--talk-name=org.freedesktop.portal.*",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "cleanup": ["/include", "/share/man"],
  "modules": [
    {
      "name": "hammerhead",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/hammerhead/cargo"
        }
      },
      "build-commands": [
        "cargo --offline fetch --manifest-path src-tauri/Cargo.toml --verbose",
        "cargo --offline build --release --manifest-path src-tauri/Cargo.toml --verbose",
        "install -Dm755 src-tauri/target/release/hammerhead -t /app/bin/",
        "install -Dm644 src-tauri/icons/128x128.png /app/share/icons/hicolor/128x128/apps/io.github.martintondel02.hammerhead.png",
        "install -Dm644 src-tauri/icons/128x128@2x.png /app/share/icons/hicolor/256x256/apps/io.github.martintondel02.hammerhead.png",
        "install -Dm644 build-aux/io.github.martintondel02.hammerhead.desktop /app/share/applications/io.github.martintondel02.hammerhead.desktop",
        "install -Dm644 io.github.martintondel02.hammerhead.metainfo.xml /app/share/metainfo/io.github.martintondel02.hammerhead.metainfo.xml"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            "src-tauri/target",
            ".git",
            ".flatpak-builder",
            "build-dir",
            "repo",
            "node_modules"
          ]
        },
        "cargo-sources.json"
      ]
    }
  ]
}